# ============================================================
# Discord TL;DR Bot Configuration (Multi-Server Production Ready)
# Copy this file to .env and fill in your values.
# NEVER commit .env or data/ to git.
# ============================================================

# Required: Discord Bot Token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Storage mode for per-server API keys entered via /config:
#   encrypted : Per-guild AES-256-GCM rows (AAD bound to guild_id) in SQLite WAL.
#               Survives restarts; API keys can NEVER be viewed.
#   memory    : RAM-only zero persistence (keys wiped on restart).
KEY_STORAGE_MODE=encrypted

# Strong secret used to derive the vault AES-256 master key (recommended in production).
# Generate one via: python -c "import secrets; print(secrets.token_urlsafe(32))"
# If blank in encrypted mode, auto-generates data/.master.key on first run.
VAULT_MASTER_KEY=

# Unified SQLite WAL database path (stores encrypted per-guild credentials & language preferences)
DB_FILE_PATH=data/tldr_bot.db

# Default language for newly joined servers: en | vi | ja | ko | zh | auto
DEFAULT_LANGUAGE=en

# Safety & Context Budget Limits
MAX_MESSAGES_HARD_CAP=1500
DEFAULT_MESSAGE_COUNT=100
MIN_MESSAGE_COUNT=5
MAX_DAYS_SINCE=7
MAX_SINGLE_MESSAGE_CHARS=800
SINGLE_PASS_TOKEN_THRESHOLD=28000
MAP_CHUNK_TARGET_TOKENS=18000
MAX_TOTAL_INPUT_TOKENS=100000
MAX_PARALLEL_MAP_CALLS=3

# Multi-Server Fair Concurrency, Caching & Lifecycle
CACHE_TTL_SECONDS=180
CACHE_MAX_ENTRIES=512
USER_COOLDOWN_SECONDS=10
MAX_CONCURRENT_PER_GUILD=2
MAX_CONCURRENT_GLOBAL=20
PURGE_ON_GUILD_REMOVE=false
LLM_REQUEST_TIMEOUT_SECONDS=60
SMOKE_TEST_TIMEOUT_SECONDS=15

# Healthcheck HTTP endpoint (/healthz): 0 = disabled locally, 8080 = recommended in Docker/Cloud
HEALTH_PORT=0

# Security: keep false in production to block SSRF to private networks/localhost.
# Set true ONLY if explicitly connecting to local Ollama/vLLM.
ALLOW_LOCAL_ENDPOINTS=false

# Optional: set a specific Guild ID for instant slash-command sync during development
DEV_GUILD_ID=

# Logging level: INFO | WARNING | DEBUG
LOG_LEVEL=INFO
